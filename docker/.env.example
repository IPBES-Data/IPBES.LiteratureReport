# Copy to .env and fill in. Never commit .env.

# Zotero API key with read access to the groups
ZOTERO_API_KEY=
# OpenAlex API key (openalexPro)
OPENALEX_API_KEY=
# GitHub token (fine-grained): read/write "Contents" on
# IPBES-Data/IPBES.LiteratureReport only (the plugin submodules are public)
GITHUB_TOKEN=
# token for POST /update (empty: triggering switched off)
TRIGGER_TOKEN=

# optional (defaults in docker-compose.yml)
# INTERVAL_MINUTES=30
# MIN_GAP_MINUTES=5
# BRANCH=main
# PUSH=true          # false: commit in the container only, for testing
# DATA_DIR=./data
# TRIGGER_PORT=8080
# versions (defaults in docker-compose.yml): R_VERSION, CRAN_DATE,
# OPENALEXPRO_MIN, ZOTFUNC_MIN
